{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@gno/*": ["src/*"],
      "@gno/styles/*": ["assets/styles/*"],
      "@gno/components/*": ["components/*"],
      "@gno/types": ["types.ts"],
      "@gno/redux": ["redux"],
      "@assets/*": ["assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
